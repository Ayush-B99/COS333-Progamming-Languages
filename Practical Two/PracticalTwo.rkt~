; TASK 3: doubleEverySecondElement

(define (doubleEverySecondElement lst)
  (define (helper lst position)
    (cond
      ((null? lst) '())
      ((even? position) (cons (* 2 (car lst)) (helper (cdr lst) (+ position 1))))
      (else (helper (cdr lst) (+ position 1)))))
  (helper lst 2))

