; TASK 2: countNonZeroValues

(define (countNonZeroValues lst)
  (cond
    ((null? lst) 0)
    ((zero? (car lst)) (countNonZeroValues (cdr lst)))
    (else (+ 1 (countNonZeroValues (cdr lst))))))

